  },
  "jest": {
    "testMatch": [
      "**/backend__tests__/**/*.test.js"
    ]
  },
  "dependencies": {
    "cl.jotacalderon.cf.framework": "1.17.0",
    "oracledb": "26.0.0",
    "zod": "4.6.7",
    "jsonwebtoken": "9.0.3",
    "argon2": "0.45.2",
    "express-recaptcha": "5.1.0",
    "googleapis": "190.0.0",
    "@azure/msal-node": "7.2.2"
  },
  "devDependencies": {
    "eslint": "10.15.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-prettier": "5.5.7",
    "globals": "17.14.0",
    "husky": "9.1.7",
    "jest": "30.5.2",
    "lint-staged": "17.6.0",
    "nodemon": "3.1.14",
    "prettier": "3.10.1"
  }
